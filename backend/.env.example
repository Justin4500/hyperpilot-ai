# HyperPilot AI — Backend Environment Configuration
# Obtain your free Google Gemini API Key at https://aistudio.google.com/
# Leave blank to start in explore mode; add your key when ready.
GEMINI_API_KEY=

# Default Model Selection (Free Tier Compatible)
# Options: gemini-3.5-flash-lite (fastest & recommended), gemini-3.5-flash, gemini-3.8-flash
DEFAULT_MODEL=gemini-3.5-flash-lite

# Browser Automation Settings
BROWSER_HEADLESS=false
TASK_TIMEOUT_SECONDS=180
MAX_STEPS=20

# Safety Guardrails
ALLOW_SENSITIVE_ACTIONS=false
